        "${workspaceFolder}/rune-backend/build/_deps/httplib-src",
        "${workspaceFolder}/rune-backend/build/_deps/nlohmann_json-src/include"
      ],
      "defines": ["_WIN32", "_WINDOWS", "UNICODE", "_UNICODE"],
