{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}/rune-backend",
        "-B", "${workspaceFolder}/rune-backend/build",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure (Release)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", "${workspaceFolder}/rune-backend",
        "-B", "${workspaceFolder}/rune-backend/build",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "CMake: Build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/rune-backend/build", "--parallel"],
      "group": { "kind": "build", "isDefault": true },
      "dependsOn": "CMake: Configure (Debug)",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": [
        "$gcc",
        {
          "owner": "cmake",
          "fileLocation": "absolute",
          "pattern": {
            "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
            "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
          }
        }
      ]
    },
    {
      "label": "CMake: Clean",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/rune-backend/build", "--target", "clean"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "npm: install rune-web",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": { "cwd": "${workspaceFolder}/rune-web" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "npm: start rune-web",
      "type": "shell",
      "command": "node",
      "args": ["index.js"],
      "options": { "cwd": "${workspaceFolder}/rune-web" },
      "group": "test",
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Check dependencies (Linux/Termux)",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/check-deps.sh"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
